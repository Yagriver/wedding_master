{
  "name": "wedding-rsvp",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-06",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGINS": "https://yagriver.github.io" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "wedding-rsvp",
    "database_id": "REPLACE_WITH_CREATED_DATABASE_ID"
  }]
}
